<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:background="@drawable/selector_card_focus"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Channel Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:contentDescription="Channel Logo"
        android:scaleType="centerCrop"
        android:src="@drawable/img_splash_bg" />

    <!-- Channel Info (Number & Name) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtChannelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CH 1"
                android:textColor="@color/gold_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStreamType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="• HLS"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/selector_card_text"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Free or Paid Badge -->
    <TextView
        android:id="@+id/txtBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@color/accent_green"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="FREE"
        android:textColor="@color/black"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
