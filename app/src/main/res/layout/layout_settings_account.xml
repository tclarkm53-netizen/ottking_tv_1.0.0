<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account &amp; Subscriber Credentials"
            android:textColor="@color/gold_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sign in with your subscriber account to unlock 4K Ultra HD live TV and VIP Channels."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Profile Panel (Visible when logged in) -->
        <LinearLayout
            android:id="@+id/panelProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_normal"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtProfileUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username: admin"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtProfilePackage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Subscription: VIP Premium Ultra Plan"
                android:textColor="@color/gold_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtProfileExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Expiry Date: 2030-12-31"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtProfileDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bound Device ID: xxxx-xxxx"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="150dp"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/accent_red"
                android:focusable="true"
                android:clickable="true"
                android:text="Logout Account"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Login Form (Visible when logged out) -->
        <LinearLayout
            android:id="@+id/panelLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subscriber Username"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edtUsername"
                android:layout_width="300dp"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/selector_card_focus"
                android:hint="Enter Username (e.g. admin)"
                android:inputType="text"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Password"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="300dp"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/selector_card_focus"
                android:hint="Enter Password (e.g. 123456)"
                android:inputType="textPassword"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="180dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/gold_primary"
                android:focusable="true"
                android:clickable="true"
                android:text="Sign In to OTT KING"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
