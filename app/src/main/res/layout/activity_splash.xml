<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/imgSplashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Splash Background"
        android:scaleType="centerCrop"
        android:src="@drawable/img_splash_bg" />

    <!-- Dark Overlay Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark_translucent" />

    <!-- Center App Branding / Normal Loading View -->
    <LinearLayout
        android:id="@+id/layoutSplashLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="App Logo"
            android:src="@drawable/img_app_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.15"
            android:text="@string/app_name"
            android:textColor="@color/gold_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Lottie Splash Loader Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieSplashLoader"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="16dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/splash_animation" />

        <TextView
            android:id="@+id/txtSplashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/splash_init_connection"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Error / No Network State Container -->
    <LinearLayout
        android:id="@+id/layoutSplashError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgErrorIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="No Network Icon"
            android:src="@drawable/ic_no_internet" />

        <TextView
            android:id="@+id/txtErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/splash_error_no_network_title"
            android:textColor="#FF5252"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="480dp"
            android:text="@string/splash_error_no_network_msg"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSplashRetry"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_retry_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/btn_retry"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSplashExit"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/btn_secondary_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/btn_exit"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="@string/copyright_text"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</RelativeLayout>
