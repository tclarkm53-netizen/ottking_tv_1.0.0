<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/imgSplashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Splash Background"
        android:scaleType="centerCrop"
        android:src="@drawable/img_splash_bg" />

    <!-- Dark Overlay Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark_translucent" />

    <!-- Center App Branding -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="App Logo"
            android:src="@drawable/img_app_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.15"
            android:text="OTT KING"
            android:textColor="@color/gold_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ULTRA LIVE TV &amp; STREAMING"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Animated Dot Progress Bar -->
        <com.ottking.devcode.ui.DotProgressBar
            android:id="@+id/dotProgressBar"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/txtSplashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Initializing Secure Connection..."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="@string/copyright_text"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</RelativeLayout>
