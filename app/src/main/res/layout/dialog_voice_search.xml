<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_normal"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Mic Icon Container with glowing pulse effect -->
    <FrameLayout
        android:id="@+id/layoutMicContainer"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_active">

        <ImageView
            android:id="@+id/imgMicStatus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="Microphone"
            android:src="@drawable/ic_mic"
            app:tint="@color/gold_primary" />

        <ProgressBar
            android:id="@+id/progressVoice"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/gold_primary"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/txtVoiceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voice Search"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="Listening... Say a channel name (e.g. Sports, News)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Action Buttons (Cancel / Retry / Search Manually) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVoiceCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_secondary_selector"
            android:focusable="true"
            android:minWidth="100dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnVoiceRetry"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_retry_selector"
            android:focusable="true"
            android:minWidth="100dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Speak Again"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
