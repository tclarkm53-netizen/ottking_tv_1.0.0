<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ExoPlayer View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <!-- TOP LEFT: Channel Overlay Card (Icon, Number, Name only) -->
    <LinearLayout
        android:id="@+id/cardChannelOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="20dp"
        android:background="@drawable/bg_card_normal"
        android:gravity="center_vertical"
        android:maxWidth="340dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/imgPlayerChannelLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Channel Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/img_splash_bg" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPlayerChannelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#A0000000"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="CH 1"
                android:textColor="@color/gold_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPlayerChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Channel Name"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- TOP RIGHT: TV Remote Number Input Overlay Card -->
    <LinearLayout
        android:id="@+id/cardChannelNumOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_normal"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHANNEL NUMBER"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtChannelNumInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="1"
            android:textColor="@color/gold_primary"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RIGHT SIDE: Sliding Channel List Container -->
    <LinearLayout
        android:id="@+id/drawerChannelList"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:background="#E00B0E14"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header of Drawer with Settings Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:text="LIVE CHANNELS"
                android:textColor="@color/gold_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPlayerVoiceSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/selector_header_button"
                android:clickable="true"
                android:contentDescription="Voice Search"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_mic" />

            <!-- Top Right Settings Icon in Drawer -->
            <ImageButton
                android:id="@+id/btnPlayerSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/selector_header_button"
                android:clickable="true"
                android:contentDescription="Player Settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />

        </LinearLayout>

        <EditText
            android:id="@+id/edtPlayerSearch"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/selector_pill_focus"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:hint="Filter channels..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPlayerChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

    </LinearLayout>

</RelativeLayout>
