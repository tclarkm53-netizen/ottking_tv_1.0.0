RewriteEngine On
RewriteBase /

# Map clean endpoints to .php scripts
RewriteRule ^update/?$ update-app.php [L,QSA]
RewriteRule ^notifications/?$ notifications.php [L,QSA]
RewriteRule ^check-session/?$ check-session.php [L,QSA]
RewriteRule ^channels/?$ channels.php [L,QSA]
RewriteRule ^categories/?$ categories.php [L,QSA]
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^logout/?$ logout.php [L,QSA]
RewriteRule ^stream-token/?$ stream-token.php [L,QSA]
RewriteRule ^cookie/?$ cookie.php [L,QSA]
RewriteRule ^edge-cookie/?$ cookie.php [L,QSA]
RewriteRule ^stream-cookie/?$ cookie.php [L,QSA]
RewriteRule ^submit-reports/?$ submit-reports.php [L,QSA]
RewriteRule ^verify-stream/?$ verify-stream.php [L,QSA]
